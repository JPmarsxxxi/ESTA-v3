{
	"name": "esta-v3",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "node scripts/dev.ts",
		"dev:editor": "bun --cwd apps/editor run dev",
		"server": "node server/index.ts",
		"build:wasm": "node scripts/build-wasm.ts",
		"typecheck": "tsc --noEmit -p apps/editor && tsc --noEmit -p server",
		"lint": "eslint apps/editor/src/esta apps/editor/src/app/esta apps/editor/src/app/page.tsx server scripts",
		"lint:all": "eslint apps/editor/src server scripts"
	},
	"dependencies": {
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"better-auth": "^1.4.15",
		"next": "^16.1.3",
		"opencut-wasm": "workspace:*"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@next/eslint-plugin-next": "^16.2.4",
		"@types/node": "^24.2.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.59.0"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide"
	]
}
